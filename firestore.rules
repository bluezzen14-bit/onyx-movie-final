rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Movies - Anyone can read, only admin can write
    match /movies/{movieId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in ['mugabibenjamin14@gmail.com', 'rachetyaz900@gmail.com'];
    }
    // App config for auto-update - Anyone can read
    match /app_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in ['mugabibenjamin14@gmail.com', 'rachetyaz900@gmail.com'];
    }
  }
}
